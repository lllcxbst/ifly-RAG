# Copy to .env and replace every CHANGE_ME value before production deployment.
APP_ENV=development
APP_NAME=航标 · 产品智能客服
PUBLIC_BASE_URL=http://localhost:8080
DATABASE_URL=postgresql+asyncpg://support_bot:CHANGE_ME_DB_PASSWORD@postgres:5432/support_bot
POSTGRES_DB=support_bot
POSTGRES_USER=support_bot
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
REDIS_URL=redis://redis:6379/0
ADMIN_API_KEY=CHANGE_ME_LONG_RANDOM_ADMIN_KEY
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET

# Any OpenAI-compatible chat/embedding endpoint can be used (OpenAI, Xinference,
# vLLM, OneAPI, etc.). Leave API keys empty to use the built-in extractive demo mode.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
GRAPH_ENABLED=true
GRAPH_LLM_MODEL=Qwen/Qwen3.5-9B
GRAPH_STORAGE_DIR=/app/graph_store
GRAPH_TOP_K=8
GRAPH_MAX_NODES=180
GRAPH_INDEX_MAX_ATTEMPTS=2
RAG_TOP_K=6
RAG_MIN_SCORE=0.28
MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
VITE_API_BASE_URL=/api/v1
